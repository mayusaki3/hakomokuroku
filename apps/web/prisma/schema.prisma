// apps/web/prisma/schema.prisma
// v0.8 initial server schema. Business semantics are defined in
// docs/ja-JP/02_アーキテクチャ/40_DBスキーマ定義.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum BusinessEntityType {
  BOX
  ITEM
  BOX_LOCATION
}

enum FullResyncSnapshotStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

enum ThemeBase {
  system
  light
  dark
}

model User {
  id           String  @id @default(cuid())
  userId       String  @unique
  userName     String?
  passwordHash String
  iconDataUrl  String?
  isActive     Boolean @default(true)

  totpEnabled          Boolean   @default(false)
  totpSecretEnc        String?
  totpPendingSecretEnc String?
  totpPendingAt        DateTime?
  recoveryCodes        Json?
  totpFailCount        Int       @default(0)
  lockUntil            DateTime?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  authSessions    AuthSession[]
  boxes           Box[]
  items           Item[]
  locations       BoxLocation[]
  devices         Device[]
  devicePrefixes  DevicePrefix[]
  themes          Theme[]
  setting         UserSetting?
  syncChanges     SyncChangeLog[]
  syncConflicts   SyncConflict[]
  restoreLock     RestoreLock?
  restoreResults  RestoreApplyResult[]
  resyncSnapshots FullResyncSnapshot[]

  @@index([userId])
}

model AuthSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime?
  deviceId   String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [userId, deviceId], references: [userId, deviceId], onDelete: NoAction)

  @@index([userId, deviceId])
  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model LoginChallenge {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  used      Boolean  @default(false)

  @@index([userId, expiresAt])
  @@index([userId, createdAt])
}

model Box {
  userId          String
  id              String
  code            String
  name            String
  locationId      String?
  parentBoxId     String?
  tags            Json
  note            String?
  thumbs          Json
  meta            Json?
  createdAt       DateTime
  updatedAt       DateTime
  deletedAt       DateTime?
  serverUpdatedAt DateTime?
  revision        BigInt    @default(0)
  contentHash     String
  syncSeq         BigInt?

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  location   BoxLocation? @relation(fields: [userId, locationId], references: [userId, id])
  parentBox  Box?         @relation("BoxNesting", fields: [userId, parentBoxId], references: [userId, id])
  childBoxes Box[]        @relation("BoxNesting")
  items      Item[]

  @@id([userId, id])
  @@unique([userId, code])
  @@index([userId, serverUpdatedAt])
  @@index([userId, syncSeq])
  @@index([userId, locationId, deletedAt])
  @@index([userId, parentBoxId, deletedAt])
}

model Item {
  userId          String
  id              String
  boxId           String
  name            String
  tags            Json
  note            String?
  thumbs          Json
  meta            Json?
  createdAt       DateTime
  updatedAt       DateTime
  deletedAt       DateTime?
  serverUpdatedAt DateTime?
  revision        BigInt    @default(0)
  contentHash     String
  syncSeq         BigInt?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  box  Box  @relation(fields: [userId, boxId], references: [userId, id])

  @@id([userId, id])
  @@index([userId, serverUpdatedAt])
  @@index([userId, syncSeq])
  @@index([userId, boxId, deletedAt])
}

model BoxLocation {
  userId          String
  id              String
  name            String
  note            String?
  thumbs          Json
  meta            Json?
  createdAt       DateTime
  updatedAt       DateTime
  deletedAt       DateTime?
  serverUpdatedAt DateTime?
  revision        BigInt    @default(0)
  contentHash     String
  syncSeq         BigInt?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  boxes Box[]

  @@id([userId, id])
  @@index([userId, serverUpdatedAt])
  @@index([userId, syncSeq])
  @@index([userId, name, deletedAt])
}

model SyncSequence {
  id      String @id
  lastSeq BigInt
}

model SyncChangeLog {
  syncSeq         BigInt             @id
  userId          String
  entityType      BusinessEntityType
  entityId        String
  revision        BigInt
  contentHash     String
  deleted         Boolean
  payload         Json
  serverUpdatedAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, syncSeq])
  @@index([serverUpdatedAt])
}

model SyncConflict {
  id                          String             @id @default(cuid())
  userId                      String
  entityType                  BusinessEntityType
  entityId                    String
  clientBaseRevision          BigInt
  clientContentHash           String
  clientPayload               Json
  serverRevisionAtConflict    BigInt
  serverContentHashAtConflict String
  serverPayloadAtConflict     Json
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([userId, entityType, entityId])
}

model RestoreLock {
  userId        String   @id
  lockTokenHash String
  expiresAt     DateTime
  createdAt     DateTime
  renewedAt     DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model RestoreApplyResult {
  userId        String
  applyId       String
  requestDigest String
  status        String
  committedAt   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, applyId])
  @@index([committedAt])
}

model FullResyncSnapshot {
  snapshotId  String                   @id
  userId      String
  snapshotSeq BigInt
  createdAt   DateTime
  expiresAt   DateTime
  status      FullResyncSnapshotStatus

  user     User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  entities FullResyncSnapshotEntity[]

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model FullResyncSnapshotEntity {
  snapshotId      String
  entityType      BusinessEntityType
  entityId        String
  payload         Json
  revision        BigInt
  contentHash     String
  syncSeq         BigInt
  serverUpdatedAt DateTime
  deleted         Boolean

  snapshot FullResyncSnapshot @relation(fields: [snapshotId], references: [snapshotId], onDelete: Cascade)

  @@id([snapshotId, entityType, entityId])
}

model Device {
  userId       String
  deviceId     String
  name         String?
  activePrefix String
  createdAt    DateTime
  lastUsedAt   DateTime

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  prefixes DevicePrefix[]
  authSessions AuthSession[]

  @@id([userId, deviceId])
  @@index([userId, lastUsedAt])
}

model DevicePrefix {
  userId      String
  prefix      String
  deviceId    String
  allocatedAt DateTime
  activatedAt DateTime
  retiredAt   DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [userId, deviceId], references: [userId, deviceId], onDelete: Cascade)

  @@id([userId, prefix])
  @@index([userId, deviceId, allocatedAt])
  @@index([userId, deviceId, retiredAt])
}

model Theme {
  id        String    @id @default(cuid())
  userId    String
  name      String
  baseTheme ThemeBase
  tokens    Json
  wallpaper Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model UserSetting {
  userId      String   @id
  activeTheme String   @default("builtin:system")
  uiSettings  Json?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
