// apps/web/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL") // 例: file:./dev.db
}

/// タグの用途
enum TagKind {
  BOX
  ITEM
  SHARED
}

model Box {
  id          String   @id
  code        String   @unique       // 箱コード（QR）
  name        String
  location    String?                // 簡易な場所名（自由記述）
  tags        Json?                  // string[] を想定（デフォルトは付与しない）
  thumbs      Json?                  // string[] サムネ（dataURL or blob URL）
  meta        Json?                  // 任意メタ（ai 状態や拡張なども可）
  aiState     String?                // "pending" | "processing" | "done" | "error"
  aiUpdatedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       Item[]
  boxLocation BoxLocation?

  @@index([updatedAt])
  @@index([aiState, updatedAt])
}

model Item {
  id          String   @id
  boxId       String
  box         Box      @relation(fields: [boxId], references: [id], onDelete:Restrict, onUpdate: Cascade)

  name        String
  tags        Json?
  note        String?
  thumbs      Json?
  meta        Json?
  aiState     String?
  aiUpdatedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([boxId])
  @@index([updatedAt])
  @@index([aiState, updatedAt])
}

model BoxLocation {
  id          String  @id
  boxId       String  @unique
  box         Box     @relation(fields: [boxId], references: [id], onDelete:Cascade, onUpdate:Cascade)

  thumbs      Json?               // 置き場所のサムネ（thumbs に統一）
  note        String?             // 置き場所のメモ
  meta        Json?
  aiState     String?
  aiUpdatedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([boxId])
  @@index([updatedAt])
  @@index([aiState, updatedAt])
}

model Tag {
  id        String   @id
  name      String
  kind      TagKind
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, kind])
  @@index([enabled, kind, name])
}
