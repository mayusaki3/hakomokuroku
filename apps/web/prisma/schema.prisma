// apps/web/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/** 箱（基本情報） */
model Box {
  id        String   @id
  code      String   @unique
  name      String
  location  String?
  tags      Json?
  thumbs    Json?                 // 箱のサムネ (dataURL等) 複数可
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items        Item[]
  locationInfo BoxLocation?

  @@index([updatedAt])
}

/** アイテム（箱に属する） */
model Item {
  id        String   @id
  boxId     String
  box       Box      @relation(fields: [boxId], references: [id], onDelete: Cascade)
  name      String
  tags      Json?
  note      String?
  thumbs    Json?                 // アイテムのサムネ 複数可
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boxId])
  @@index([updatedAt])
}

/** 箱の“置き場所”の詳細（サムネ＋メモ） */
model BoxLocation {
  id        String   @id
  boxId     String   @unique
  box       Box      @relation(fields: [boxId], references: [id], onDelete: Cascade)

  thumbs    Json?                 // 置き場所サムネ（dataURL等）※元画像は扱わない想定
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
