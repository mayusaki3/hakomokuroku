// apps/web/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL") // 例: file:./dev.db
}

/// タグの用途
enum TagKind {
  BOX
  ITEM
  SHARED
}

model User {
  id            String   @id @default(cuid())
  userId        String   @unique               // ログイン用ID
  userName      String?
  passwordHash  String                         // argon2id
  iconDataUrl   String?
  isActive      Boolean  @default(true)

  // TOTP
  totpEnabled   Boolean  @default(false)
  totpSecretEnc String?
  totpPendingSecretEnc String?
  recoveryCodes Json?                          // ["hash1","hash2",...]
  totpFailCount Int      @default(0)
  lockUntil     DateTime?

  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tokens        SyncToken[]
  boxes         Box[]
  items         Item[]
  locations     BoxLocation[]
  tags          Tag[]
  themes          Theme[]
  setting         UserSetting?

  @@index([userId])
}

model SyncToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique                 // 平文は返却のみ／DBはハッシュ
  issuedAt   DateTime @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime?
  deviceName String?
  userAgent  String?
  ip         String?

  @@index([userId])
  @@index([expiresAt])
}

model LoginChallenge {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  used      Boolean  @default(false)

  @@index([userId, expiresAt])
  @@index([userId, createdAt])
}

model Box {
  id           String   @id                  // 既存クライアント生成IDを踏襲
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  code         String
  name         String
  location     String?
  tags         Json?
  thumbs       Json?
  meta         Json?
  aiState      String?
  aiUpdatedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items        Item[]
  boxLocation  BoxLocation?

  @@unique([userId, code])                   // コードはユーザー内で一意（UNASSIGNED もここで制御）
  @@index([userId, updatedAt])
  @@index([aiState, updatedAt])
}

model Item {
  id           String   @id
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  boxId        String
  box          Box      @relation(fields: [boxId], references: [id], onDelete: Cascade)

  name         String
  tags         Json?
  note         String?
  thumbs       Json?
  meta         Json?
  aiState      String?
  aiUpdatedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, updatedAt])
  @@index([boxId])
}

model BoxLocation {
  id           String   @id
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  boxId        String   @unique             // 箱1つに1レコード
  box          Box      @relation(fields: [boxId], references: [id], onDelete: Cascade)

  thumbs       Json?
  note         String?
  meta         Json?
  aiState      String?
  aiUpdatedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, updatedAt])
}

model Tag {
  id        String   @id
  userId    String?                          // 共有タグは null、ユーザー専用は userId 指定
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  kind      TagKind
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name, kind])             // ユーザー内で一意（共有は userId=null 扱い）
  @@index([enabled, kind, name])
  @@index([userId, name, kind])
}

model Theme {
  id             String   @id @default(cuid())
  userId         String
  name           String
  vars           Json?
  wallpaperThumb String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model ThemeActive {
  userId   String   @id
  themeId  String?  // 空=デフォルト
  vars     Json?    // テーマの CSS 変数一式（null/空でデフォルト扱い）
  updatedAt DateTime @updatedAt
}

enum VisionProvider {
  none
  openai
  claude
  gemini
}

model UserSetting {
  userId           String   @id
  visionProvider   VisionProvider @default(none)
  visionApiKeyEnc  String?
  visionPromptName String?
  visionPromptTags String?
  visionPromptNote String?
  uiVars           Json?

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}
