// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL") // .env に DATABASE_URL="file:./dev.db"
}

model ThemeActive {
  userId    String   @id
  themeId   String?
  vars      Json?
  updatedAt DateTime @updatedAt
}
